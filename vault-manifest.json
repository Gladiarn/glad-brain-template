    "vault-manifest.json",
    "brain/Skills.md",
    "portfolio/competencies/README.md",
    "thinking/README.md",
    "work/meetings/README.md"
  ],
  "scaffold": {
    "brain/North Star.md": "Personal goals — replace if source has real content",
    "brain/Memories.md": "Memory index — replace if source has entries beyond template stubs",
    "brain/Key Decisions.md": "Decision log — replace if non-empty",
    "brain/Patterns.md": "Observed patterns — replace if non-empty",
    "brain/Gotchas.md": "Known gotchas — replace if non-empty",
    "work/Index.md": "Work notes MOC — replace if has real entries",
    "clients/Clients.md": "Clients MOC — replace if has real entries",
    "portfolio/Portfolio.md": "Portfolio index — replace if has entries",
    "projects.map.json": "Repo-to-project map — replace if it has real entries"
  },
  "user_content_roots": [
    "work/active/",
    "work/archive/",
    "work/incidents/",
    "clients/*.md",
    "clients/contacts/",
    "portfolio/wins/",
    "portfolio/case-studies/",
    "portfolio/competencies/*.md",
    "brain/*.md",
    "reference/",
    "memories/"
