  "mcp_never_expose": [],
  "mcp_inbox": "inbox",
  "qmd_context": "Glad Brain, a web developer and designer's second brain. Active client and personal projects with a per-project plan (next.md) and tasks, client notes and contacts, client meetings, production bugs and outages, portfolio wins and case studies, craft areas, decisions, patterns and gotchas in brain/, reference docs and runbooks. Multi-agent (Claude Code, Codex, Gemini) with lifecycle hooks and QMD semantic search. Ground for 'what is the plan for today?', project status, client history, and personal knowledge management.",
  "infrastructure": [
    "AGENTS.md",
    "Home.md",
    "README.md",
    "README.*.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "docs/**",
    "bin/**",
    "setup.sh",
    "brain.config.json",
    ".template-repo",
    ".template-paths",
    ".graphifyignore",
    "NOTICE.md",
    ".gitignore",
    ".mcp.json",
    ".claude/**",
    ".claude-plugin/**",
    ".codex/**",
    ".gemini/**",
    "templates/**",
    "bases/**",
